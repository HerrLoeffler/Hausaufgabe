{
  "$schemaVersion": 1,
  "version": "1.3.0",
  "root": "assets/gradecrew",
  "brand": {
    "primary": "brand-primary-v1.svg",
    "icon": "brand-icon-v1.svg",
    "favicon": "brand-icon-v1.svg",
    "crewLineup": "crew-lineup.svg"
  },
  "mascots": {
    "coco": {
      "role": "guide",
      "animal": "penguin",
      "primary": "penguin-guide.svg",
      "welcome": "penguin-guide-welcome.svg",
      "nameScene": "clay-coco-name.svg",
      "runCuddle": "coco-run-cuddle-v1.png"
    },
    "remy": {
      "role": "create",
      "animal": "elephant",
      "primary": "elephant-create.svg",
      "welcome": "elephant-create-welcome.svg",
      "writingScene": "clay-remy-writing.svg",
      "microphone": "remy-microphone-v1.png",
      "runCuddle": "remy-run-cuddle-v1.png",
      "microphoneForward": "remy-microphone-forward-v1.png"
    },
    "emmi": {
      "role": "improve",
      "animal": "fox",
      "primary": "fox-improve.svg",
      "welcome": "fox-improve-welcome.svg",
      "runCuddle": "emmi-run-cuddle-v1.png"
    },
    "wilma": {
      "role": "grade",
      "animal": "owl",
      "primary": "owl-grade.svg",
      "welcome": "owl-grade-welcome.svg",
      "runCuddle": "wilma-run-cuddle-v1.png"
    }
  },
  "scenes": {
    "welcome": "clay-welcome.svg",
    "finale": "clay-finale.svg",
    "introduceRemy": "clay-introduce-remy.svg",
    "introduceEmmi": "clay-introduce-emmi.svg",
    "introduceWilma": "clay-introduce-wilma.svg",
    "thanksRemy": "clay-thanks-remy.svg",
    "thanksEmmi": "clay-thanks-emmi.svg",
    "thanksWilma": "clay-thanks-wilma.svg",
    "wait": "clay-wait.svg",
    "save": "clay-save.svg",
    "retry": "clay-retry.svg",
    "yourTurn": "clay-your-turn.svg"
  },
  "rules": {
    "singleSource": true,
    "noProductSpecificCopies": true,
    "legacyAliasesMayExist": true,
    "newCodeMustUseManifestNames": true,
    "brandCoreRequiredFor": [
      "web",
      "teacherApp",
      "games",
      "live",
      "student"
    ],
    "secureUsesDedicatedVariant": true,
    "faviconMustUseIconAsset": true,
    "iconMustRemainVector": true
  }
}
