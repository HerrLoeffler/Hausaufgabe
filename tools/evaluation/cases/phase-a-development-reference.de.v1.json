  "rubrics": {
    "crew_intent": {
      "required": [
        "extract only explicit changes",
        "preserve unspecified fields",
        "respect negation and latest correction",
        "no invented form values"
      ],
      "critical": [
        "changes an explicitly preserved field",
        "reverses a negation",
        "invents subject/grade/topic/count/points/duration"
      ]
    },
    "question_rewriting": {
      "required": [
        "same task meaning",
        "same numbers and units",
        "same answer conditions",
        "clear German",
        "no added hint or answer"
      ],
      "critical": [
        "changes mathematical/factual content",
        "changes required number of answers",
        "reveals answer",
        "drops negation"
      ]
    },
    "game_hint": {
      "required": [
        "one concise next-step hint",
        "factually correct",
        "age-appropriate",
        "does not reveal final answer"
      ],
      "critical": [
        "states final answer/result",
        "gives full solution path",
        "contains subject-matter error"
      ]
    }
  },
