rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsQuiz(quizId) {
      return signedIn()
        && get(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId == request.auth.uid;
    }

    function quizPublished(quizId) {
      let quiz = get(/databases/$(database)/documents/quizzes/$(quizId)).data;
      return quiz.published == true && quiz.get('ended', false) == false;
    }

    function quizShared(quizId) {
      let quiz = get(/databases/$(database)/documents/quizzes/$(quizId)).data;
      return signedIn() && quiz.get('shareEnabled', false) == true;
    }

    // Lehrerprofile: nur der jeweilige Benutzer selbst.
    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /quizzes/{quizId} {
      // Veröffentlichte Tests sind für Schüler lesbar. Bei beendeten Tests darf nur
      // die Test-Metainfo gelesen werden, damit eine verständliche Meldung erscheint.
      // Geteilte Vorlagen sind ausschließlich für angemeldete Lehrkräfte lesbar.
      allow get: if resource.data.published == true
                 || resource.data.get('ended', false) == true
                 || (signedIn() && resource.data.ownerId == request.auth.uid)
                 || (signedIn() && resource.data.get('shareEnabled', false) == true);

      // Diese Query wird im Lehrer-Dashboard immer mit ownerId == request.auth.uid ausgeführt.
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /questions/{questionId} {
        allow read: if quizPublished(quizId) || ownsQuiz(quizId) || quizShared(quizId);
        allow create, update, delete: if ownsQuiz(quizId);
      }

      // Serverseitiger Startzeitpunkt für Tests mit Zeitlimit.
      // Schüler kennen nur ihre zufällige attemptId; eine Auflistung ist nicht erlaubt.
      match /attempts/{attemptId} {
        allow create: if quizPublished(quizId)
                      && request.resource.data.timeLimitMinutes is int
                      && request.resource.data.timeLimitMinutes >= 1
                      && request.resource.data.timeLimitMinutes <= 300
                      && request.resource.data.startedAt == request.time;

        allow get: if quizPublished(quizId) || ownsQuiz(quizId);
        allow list, delete: if ownsQuiz(quizId);
        allow update: if false;
      }

      match /submissions/{submissionId} {
        // Schüler dürfen nur neue Abgaben an aktuell geöffnete Tests schreiben.
        // Lesen/Ändern dürfen ausschließlich die Eigentümer des Tests.
        allow create: if quizPublished(quizId)
                      && request.resource.data.studentName is string
                      && request.resource.data.studentName.size() > 0
                      && request.resource.data.studentName.size() <= 120
                      && request.resource.data.answers is map;

        allow read, update, delete: if ownsQuiz(quizId);
      }
    }

    // TEMPORÄR: erhält die alte V1 unter /submissions am Leben.
    // Sobald V2 produktiv ersetzt, kann dieser Block entfernt werden.
    match /submissions/{legacyId} {
      allow create, read: if true;
      allow update, delete: if false;
    }
  }
}
