{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "ai",
      "runtime": "nodejs22"
    },
    {
      "source": "assessment-functions",
      "codebase": "assessment",
      "runtime": "nodejs22"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
